  id          String   @id @default(uuid()) @db.Uuid
  code        String   @unique
  nameTh      String   @map("name_th")
  nameEn      String   @map("name_en")
  description String?
  sortOrder   Int      @default(0) @map("sort_order")
  isActive    Boolean  @default(true) @map("is_active")
  isSystem    Boolean  @default(true) @map("is_system")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  payments Payment[]

  @@map("payment_statuses")
  @@schema("platform")
}

model PaymentMethod {
  id          String   @id @default(uuid()) @db.Uuid
  code        String   @unique
  nameTh      String   @map("name_th")
  nameEn      String   @map("name_en")
  description String?
  sortOrder   Int      @default(0) @map("sort_order")
  isActive    Boolean  @default(true) @map("is_active")
  isSystem    Boolean  @default(true) @map("is_system")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  payments Payment[]

  @@map("payment_methods")
  @@schema("platform")
}

model BillingAccount {
  id                      String    @id @default(uuid()) @db.Uuid
  organizationId          String    @unique @map("organization_id") @db.Uuid
  currency                String    @default("THB")
  statusId                String    @map("status_id") @db.Uuid
  currentBalanceSnapshot  Decimal?  @map("current_balance_snapshot") @db.Decimal(18, 2)
  creditLimit             Decimal?  @map("credit_limit") @db.Decimal(18, 2)
  allowNegativeBalance    Boolean   @default(false) @map("allow_negative_balance")
  createdAt               DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt               DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  status       BillingAccountStatus @relation(fields: [statusId], references: [id])
  transactions CreditTransaction[]
  invoices     Invoice[]
  payments     Payment[]

  @@index([statusId])
  @@map("billing_accounts")
  @@schema("platform")
}

model CreditTransaction {
  id                    String   @id @default(uuid()) @db.Uuid
  billingAccountId      String   @map("billing_account_id") @db.Uuid
  organizationId        String   @map("organization_id") @db.Uuid
  transactionTypeId     String   @map("transaction_type_id") @db.Uuid
  directionId           String   @map("direction_id") @db.Uuid
  amount                Decimal  @db.Decimal(18, 2)
  currency              String
  balanceBefore         Decimal  @map("balance_before") @db.Decimal(18, 2)
  balanceAfter          Decimal  @map("balance_after") @db.Decimal(18, 2)
  referenceType         String?  @map("reference_type")
  referenceId           String?  @map("reference_id") @db.Uuid
  reason                String
  metadata              Json     @default("{}") @db.JsonB
  effectiveAt           DateTime @default(now()) @map("effective_at") @db.Timestamptz(6)
  createdBy             String?  @map("created_by") @db.Uuid
  createdAt             DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  idempotencyKey        String?  @map("idempotency_key")
  reversesTransactionId String?  @map("reverses_transaction_id") @db.Uuid

  billingAccount      BillingAccount        @relation(fields: [billingAccountId], references: [id])
  organization        Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  transactionType     CreditTransactionType @relation(fields: [transactionTypeId], references: [id])
  direction           CreditDirection       @relation(fields: [directionId], references: [id])
  reversesTransaction CreditTransaction?    @relation("CreditReversal", fields: [reversesTransactionId], references: [id])
  reversedBy          CreditTransaction[]   @relation("CreditReversal")

  @@index([billingAccountId, createdAt(sort: Desc)])
  @@index([organizationId, createdAt(sort: Desc)])
  @@index([transactionTypeId])
  @@map("credit_transactions")
  @@schema("platform")
}

model Invoice {
  id                String    @id @default(uuid()) @db.Uuid
  organizationId    String    @map("organization_id") @db.Uuid
  billingAccountId  String    @map("billing_account_id") @db.Uuid
  invoiceNumber     String    @unique @map("invoice_number")
  currency          String    @default("THB")
  subtotal          Decimal   @default(0) @db.Decimal(18, 2)
  discountTotal     Decimal   @default(0) @map("discount_total") @db.Decimal(18, 2)
  taxTotal          Decimal   @default(0) @map("tax_total") @db.Decimal(18, 2)
  grandTotal        Decimal   @default(0) @map("grand_total") @db.Decimal(18, 2)
  paidTotal         Decimal   @default(0) @map("paid_total") @db.Decimal(18, 2)
  outstandingTotal  Decimal   @default(0) @map("outstanding_total") @db.Decimal(18, 2)
  statusId          String    @map("status_id") @db.Uuid
  issueDate         DateTime? @map("issue_date") @db.Date
  dueDate           DateTime? @map("due_date") @db.Date
  paidAt            DateTime? @map("paid_at") @db.Timestamptz(6)
  notes             String?
  createdBy         String?   @map("created_by") @db.Uuid
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization   Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  billingAccount BillingAccount       @relation(fields: [billingAccountId], references: [id])
  status         InvoiceStatus        @relation(fields: [statusId], references: [id])
  items          InvoiceItem[]
  allocations    PaymentAllocation[]

  @@index([organizationId, createdAt(sort: Desc)])
  @@index([statusId, dueDate])
  @@map("invoices")
  @@schema("platform")
}

model InvoiceItem {
  id              String   @id @default(uuid()) @db.Uuid
  invoiceId       String   @map("invoice_id") @db.Uuid
  itemType        String   @map("item_type")
  productId       String?  @map("product_id") @db.Uuid
  planId          String?  @map("plan_id") @db.Uuid
  subscriptionId  String?  @map("subscription_id") @db.Uuid
  description     String
  quantity        Decimal  @default(1) @db.Decimal(18, 4)
  unitPrice       Decimal  @default(0) @map("unit_price") @db.Decimal(18, 2)
  discountAmount  Decimal  @default(0) @map("discount_amount") @db.Decimal(18, 2)
  taxAmount       Decimal  @default(0) @map("tax_amount") @db.Decimal(18, 2)
  lineTotal       Decimal  @default(0) @map("line_total") @db.Decimal(18, 2)
  metadata        Json     @default("{}") @db.JsonB
  sortOrder       Int      @default(0) @map("sort_order")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
  @@map("invoice_items")
  @@schema("platform")
}

model Payment {
  id                String    @id @default(uuid()) @db.Uuid
  organizationId    String    @map("organization_id") @db.Uuid
  billingAccountId  String    @map("billing_account_id") @db.Uuid
  paymentNumber     String    @unique @map("payment_number")
  paymentMethodId   String    @map("payment_method_id") @db.Uuid
  statusId          String    @map("status_id") @db.Uuid
  amount            Decimal   @db.Decimal(18, 2)
  currency          String    @default("THB")
  paidAt            DateTime  @map("paid_at") @db.Timestamptz(6)
  referenceNumber   String?   @map("reference_number")
  evidenceUrl       String?   @map("evidence_url")
  notes             String?
  recordedBy        String?   @map("recorded_by") @db.Uuid
  confirmedBy       String?   @map("confirmed_by") @db.Uuid
  confirmedAt       DateTime? @map("confirmed_at") @db.Timestamptz(6)
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization   Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  billingAccount BillingAccount      @relation(fields: [billingAccountId], references: [id])
  paymentMethod  PaymentMethod       @relation(fields: [paymentMethodId], references: [id])
  status         PaymentStatus       @relation(fields: [statusId], references: [id])
  allocations    PaymentAllocation[]

  @@index([organizationId, createdAt(sort: Desc)])
  @@index([statusId])
  @@map("payments")
  @@schema("platform")
}

model PaymentAllocation {
  id        String   @id @default(uuid()) @db.Uuid
  paymentId String   @map("payment_id") @db.Uuid
  invoiceId String   @map("invoice_id") @db.Uuid
  amount    Decimal  @db.Decimal(18, 2)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  invoice Invoice @relation(fields: [invoiceId], references: [id])

  @@unique([paymentId, invoiceId])
  @@index([invoiceId])
  @@map("payment_allocations")
  @@schema("platform")
}

model BillingContact {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  name           String
  email          String
  phone          String?
  title          String?
  isPrimary      Boolean  @default(false) @map("is_primary")
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, isActive])
  @@map("billing_contacts")
  @@schema("platform")
}

// ——— Staff customer-portfolio management (Phase 1) ———
// Staff (sales / account managers) get assigned specific customer
// organizations here, then manage that customer's users/roles/permissions
// from Platform Admin. Staff are never added as OrganizationMembership rows.

model StaffOrganizationAssignment {
  id                   String    @id @default(uuid()) @db.Uuid
  staffUserProfileId   String    @map("staff_user_profile_id") @db.Uuid
  organizationId       String    @map("organization_id") @db.Uuid
  assignedByAuthUserId String?   @map("assigned_by_auth_user_id") @db.Uuid
  assignedAt           DateTime  @default(now()) @map("assigned_at") @db.Timestamptz(6)
  revokedAt            DateTime? @map("revoked_at") @db.Timestamptz(6)
  note                 String?
  createdAt            DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  staffUserProfile UserProfile  @relation("StaffPortfolioAssignments", fields: [staffUserProfileId], references: [id], onDelete: Cascade)
  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([staffUserProfileId])
  @@index([organizationId])
  @@index([staffUserProfileId, organizationId])
  @@map("staff_organization_assignments")
  @@schema("platform")
}
