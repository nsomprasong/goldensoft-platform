// ─── Business tables ──────────────────────────────────────────────────────

model UserProfile {
  id             String   @id @default(uuid()) @db.Uuid
  authUserId     String   @unique @map("auth_user_id") @db.Uuid
  email          String   @unique
  displayName    String   @map("display_name")
  statusId       String   @map("status_id") @db.Uuid
  sessionVersion Int      @default(0) @map("session_version")
  lastLoginAt    DateTime? @map("last_login_at") @db.Timestamptz(6)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt      DateTime? @map("deleted_at") @db.Timestamptz(6)

  status                     UserProfileStatus               @relation(fields: [statusId], references: [id])
  platformRoles              PlatformRoleAssignment[]
  memberships                OrganizationMembership[]
  preference                 UserPreference?
  organizationProductMembers OrganizationProductMembership[]
  invitationsSent            UserInvitation[]              @relation("InvitationInviter")
  staffPortfolioAssignments  StaffOrganizationAssignment[] @relation("StaffPortfolioAssignments")

  @@index([statusId])
  @@map("user_profiles")
  @@schema("platform")
}

model UserPreference {
  id                 String   @id @default(uuid()) @db.Uuid
  userProfileId      String   @unique @map("user_profile_id") @db.Uuid
  lastOrganizationId String?  @map("last_organization_id") @db.Uuid
  lastBranchId       String?  @map("last_branch_id") @db.Uuid
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  userProfile UserProfile @relation(fields: [userProfileId], references: [id], onDelete: Cascade)

  @@map("user_preferences")
  @@schema("platform")
}

model PlatformRoleAssignment {
  id                   String    @id @default(uuid()) @db.Uuid
  userProfileId        String    @map("user_profile_id") @db.Uuid
  roleId               String    @map("role_id") @db.Uuid
  statusId             String    @map("status_id") @db.Uuid
  assignedAt           DateTime  @default(now()) @map("assigned_at") @db.Timestamptz(6)
  assignedByAuthUserId String?   @map("assigned_by_auth_user_id") @db.Uuid
  revokedAt            DateTime? @map("revoked_at") @db.Timestamptz(6)

  userProfile UserProfile      @relation(fields: [userProfileId], references: [id], onDelete: Cascade)
  role        PlatformRole     @relation(fields: [roleId], references: [id])
  status      AssignmentStatus @relation(fields: [statusId], references: [id])

  @@index([userProfileId, statusId])
  @@index([roleId])
  @@map("platform_role_assignments")
  @@schema("platform")
}

model Organization {
  id           String    @id @default(uuid()) @db.Uuid
  customerCode String    @unique @map("customer_code")
  slug         String    @unique
  legalName    String    @map("legal_name")
  displayName  String    @map("display_name")
  nameEn       String?   @map("name_en")
  email        String?
  phone        String?
  address      String?
  statusId     String    @map("status_id") @db.Uuid
  taxId        String?   @map("tax_id")
  timezone     String    @default("Asia/Bangkok")
  currency     String    @default("THB")
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt    DateTime? @map("deleted_at") @db.Timestamptz(6)

  status                 OrganizationStatus             @relation(fields: [statusId], references: [id])
  branches               Branch[]
  memberships            OrganizationMembership[]
  subscriptions          Subscription[]
  productMemberships     OrganizationProductMembership[]
  auditLogs              AuditLog[]
  legacyIdentityMappings LegacyIdentityMapping[]
  userInvitations        UserInvitation[]
  organizationRoles      OrganizationRole[]
  entitlements           Entitlement[]
  onboardings            OrganizationOnboarding[]
  subscriptionHistories  SubscriptionHistory[]
  billingAccounts        BillingAccount[]
  creditTransactions     CreditTransaction[]
  invoices               Invoice[]
  payments               Payment[]
  billingContacts        BillingContact[]
  staffPortfolioAssignments StaffOrganizationAssignment[]

  @@index([statusId])
  @@map("organizations")
  @@schema("platform")
}

model Branch {
  id                     String    @id @default(uuid()) @db.Uuid
  organizationId         String    @map("organization_id") @db.Uuid
  code                   String
  name                   String
  nameEn                 String?   @map("name_en")
  statusId               String    @map("status_id") @db.Uuid
  timezone               String    @default("Asia/Bangkok")
  address                String?
  email                  String?
  phone                  String?
  latitude               Decimal?  @db.Decimal(10, 7)
  longitude              Decimal?  @db.Decimal(10, 7)
  attendanceRadiusMeters Int?      @map("attendance_radius_meters")
  isPrimary              Boolean   @default(false) @map("is_primary")
  createdAt              DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt              DateTime? @map("deleted_at") @db.Timestamptz(6)

  organization Organization                         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  status       BranchStatus                         @relation(fields: [statusId], references: [id])
  branchScopes OrganizationMembershipBranchScope[]

  @@unique([organizationId, code])
  @@index([organizationId, statusId])
  @@map("branches")
  @@schema("platform")
}

model OrganizationMembership {
  id                  String    @id @default(uuid()) @db.Uuid
  organizationId      String    @map("organization_id") @db.Uuid
  userProfileId       String    @map("user_profile_id") @db.Uuid
  statusId            String    @map("status_id") @db.Uuid
  joinedAt            DateTime? @map("joined_at") @db.Timestamptz(6)
  invitedByAuthUserId String?   @map("invited_by_auth_user_id") @db.Uuid
  endedAt             DateTime? @map("ended_at") @db.Timestamptz(6)
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization       Organization                        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userProfile        UserProfile                         @relation(fields: [userProfileId], references: [id], onDelete: Cascade)
  status             MembershipStatus                    @relation(fields: [statusId], references: [id])
  roles              OrganizationMembershipRole[]
  branchScopes       OrganizationMembershipBranchScope[]
  productMemberships OrganizationProductMembership[]

  @@unique([organizationId, userProfileId])
  @@index([userProfileId, statusId])
  @@map("organization_memberships")
  @@schema("platform")
}

model OrganizationMembershipRole {
  id           String    @id @default(uuid()) @db.Uuid
  membershipId String    @map("membership_id") @db.Uuid
  roleId       String    @map("role_id") @db.Uuid
  statusId     String    @map("status_id") @db.Uuid
  assignedAt   DateTime  @default(now()) @map("assigned_at") @db.Timestamptz(6)
  revokedAt    DateTime? @map("revoked_at") @db.Timestamptz(6)

  membership OrganizationMembership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
