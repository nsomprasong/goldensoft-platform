// ─── Business tables ──────────────────────────────────────────────────────

model UserProfile {
  id             String   @id @default(uuid()) @db.Uuid
  authUserId     String   @unique @map("auth_user_id") @db.Uuid
  email          String   @unique
  displayName    String   @map("display_name")
  statusId       String   @map("status_id") @db.Uuid
  sessionVersion Int      @default(0) @map("session_version")
  lastLoginAt    DateTime? @map("last_login_at") @db.Timestamptz(6)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt      DateTime? @map("deleted_at") @db.Timestamptz(6)

  status                     UserProfileStatus               @relation(fields: [statusId], references: [id])
  platformRoles              PlatformRoleAssignment[]
  memberships                OrganizationMembership[]
  preference                 UserPreference?
  organizationProductMembers OrganizationProductMembership[]

  @@index([statusId])
  @@map("user_profiles")
  @@schema("platform")
}

model UserPreference {
  id                 String   @id @default(uuid()) @db.Uuid
  userProfileId      String   @unique @map("user_profile_id") @db.Uuid
  lastOrganizationId String?  @map("last_organization_id") @db.Uuid
  lastBranchId       String?  @map("last_branch_id") @db.Uuid
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  userProfile UserProfile @relation(fields: [userProfileId], references: [id], onDelete: Cascade)

  @@map("user_preferences")
  @@schema("platform")
}

model PlatformRoleAssignment {
  id                   String    @id @default(uuid()) @db.Uuid
  userProfileId        String    @map("user_profile_id") @db.Uuid
  roleId               String    @map("role_id") @db.Uuid
  statusId             String    @map("status_id") @db.Uuid
  assignedAt           DateTime  @default(now()) @map("assigned_at") @db.Timestamptz(6)
  assignedByAuthUserId String?   @map("assigned_by_auth_user_id") @db.Uuid
  revokedAt            DateTime? @map("revoked_at") @db.Timestamptz(6)

  userProfile UserProfile      @relation(fields: [userProfileId], references: [id], onDelete: Cascade)
  role        PlatformRole     @relation(fields: [roleId], references: [id])
  status      AssignmentStatus @relation(fields: [statusId], references: [id])

  @@index([userProfileId, statusId])
  @@index([roleId])
  @@map("platform_role_assignments")
  @@schema("platform")
}

model Organization {
  id           String    @id @default(uuid()) @db.Uuid
  customerCode String    @unique @map("customer_code")
  slug         String    @unique
  legalName    String    @map("legal_name")
  displayName  String    @map("display_name")
  statusId     String    @map("status_id") @db.Uuid
  taxId        String?   @map("tax_id")
  timezone     String    @default("Asia/Bangkok")
  currency     String    @default("THB")
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt    DateTime? @map("deleted_at") @db.Timestamptz(6)

  status                 OrganizationStatus             @relation(fields: [statusId], references: [id])
  branches               Branch[]
  memberships            OrganizationMembership[]
  subscriptions          Subscription[]
  productMemberships     OrganizationProductMembership[]
  auditLogs              AuditLog[]
  legacyIdentityMappings LegacyIdentityMapping[]

  @@index([statusId])
  @@map("organizations")
  @@schema("platform")
}

model Branch {
  id                     String    @id @default(uuid()) @db.Uuid
  organizationId         String    @map("organization_id") @db.Uuid
  code                   String
  name                   String
  statusId               String    @map("status_id") @db.Uuid
  timezone               String    @default("Asia/Bangkok")
  address                String?
  latitude               Decimal?  @db.Decimal(10, 7)
  longitude              Decimal?  @db.Decimal(10, 7)
  attendanceRadiusMeters Int?      @map("attendance_radius_meters")
  createdAt              DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt              DateTime? @map("deleted_at") @db.Timestamptz(6)

  organization Organization                         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  status       BranchStatus                         @relation(fields: [statusId], references: [id])
  branchScopes OrganizationMembershipBranchScope[]

  @@unique([organizationId, code])
  @@index([organizationId, statusId])
  @@map("branches")
  @@schema("platform")
}

model OrganizationMembership {
  id                  String    @id @default(uuid()) @db.Uuid
  organizationId      String    @map("organization_id") @db.Uuid
  userProfileId       String    @map("user_profile_id") @db.Uuid
  statusId            String    @map("status_id") @db.Uuid
  joinedAt            DateTime? @map("joined_at") @db.Timestamptz(6)
  invitedByAuthUserId String?   @map("invited_by_auth_user_id") @db.Uuid
  endedAt             DateTime? @map("ended_at") @db.Timestamptz(6)
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization       Organization                        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userProfile        UserProfile                         @relation(fields: [userProfileId], references: [id], onDelete: Cascade)
  status             MembershipStatus                    @relation(fields: [statusId], references: [id])
  roles              OrganizationMembershipRole[]
  branchScopes       OrganizationMembershipBranchScope[]
  productMemberships OrganizationProductMembership[]

  @@unique([organizationId, userProfileId])
  @@index([userProfileId, statusId])
  @@map("organization_memberships")
  @@schema("platform")
}

model OrganizationMembershipRole {
  id           String    @id @default(uuid()) @db.Uuid
  membershipId String    @map("membership_id") @db.Uuid
  roleId       String    @map("role_id") @db.Uuid
  statusId     String    @map("status_id") @db.Uuid
  assignedAt   DateTime  @default(now()) @map("assigned_at") @db.Timestamptz(6)
  revokedAt    DateTime? @map("revoked_at") @db.Timestamptz(6)

  membership OrganizationMembership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  role       OrganizationRole       @relation(fields: [roleId], references: [id])
  status     AssignmentStatus       @relation(fields: [statusId], references: [id])

  @@index([membershipId, statusId])
  @@index([roleId])
  @@map("organization_membership_roles")
  @@schema("platform")
}

model OrganizationMembershipBranchScope {
  id           String   @id @default(uuid()) @db.Uuid
  membershipId String   @map("membership_id") @db.Uuid
  scopeTypeId  String   @map("scope_type_id") @db.Uuid
  branchId     String?  @map("branch_id") @db.Uuid
  statusId     String   @map("status_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  membership OrganizationMembership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  scopeType  BranchScopeType        @relation(fields: [scopeTypeId], references: [id])
  branch     Branch?                @relation(fields: [branchId], references: [id], onDelete: Cascade)
  status     AssignmentStatus       @relation(fields: [statusId], references: [id])

  @@index([membershipId, statusId])
  @@map("organization_membership_branch_scopes")
  @@schema("platform")
}

model Product {
  id        String   @id @default(uuid()) @db.Uuid
  code      String   @unique
  name      String
  statusId  String   @map("status_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  status             ProductStatus                   @relation(fields: [statusId], references: [id])
  features           Feature[]
  plans              Plan[]
  subscriptions      Subscription[]
  productMemberships OrganizationProductMembership[]

  @@index([statusId])
  @@map("products")
  @@schema("platform")
}

model Feature {
  id          String   @id @default(uuid()) @db.Uuid
  productId   String   @map("product_id") @db.Uuid
  code        String   @unique
  name        String
  description String?
  statusId    String   @map("status_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  product               Product                       @relation(fields: [productId], references: [id], onDelete: Cascade)
  status                FeatureStatus                 @relation(fields: [statusId], references: [id])
  planVersionFeatures   PlanVersionFeature[]
  subscriptionOverrides SubscriptionFeatureOverride[]

  @@index([productId])
  @@index([statusId])
  @@map("features")
  @@schema("platform")
}

model Plan {
  id        String   @id @default(uuid()) @db.Uuid
  productId String   @map("product_id") @db.Uuid
  code      String
  name      String
  statusId  String   @map("status_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  product       Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  status        PlanStatus     @relation(fields: [statusId], references: [id])
  versions      PlanVersion[]
  subscriptions Subscription[]

  @@unique([productId, code])
  @@index([statusId])
  @@map("plans")
  @@schema("platform")
}

model PlanVersion {
  id                    String    @id @default(uuid()) @db.Uuid
  planId                String    @map("plan_id") @db.Uuid
  versionNumber         Int       @map("version_number")
  statusId              String    @map("status_id") @db.Uuid
  billingCycleDefaultId String    @map("billing_cycle_default_id") @db.Uuid
  priceAmount           Decimal   @map("price_amount") @db.Decimal(12, 2)
  currency              String    @default("THB")
  trialDays             Int?      @map("trial_days")
  publishedAt           DateTime? @map("published_at") @db.Timestamptz(6)
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  plan                Plan                 @relation(fields: [planId], references: [id], onDelete: Cascade)
  status              PlanVersionStatus    @relation(fields: [statusId], references: [id])
  billingCycleDefault BillingCycle         @relation("PlanVersionBillingCycle", fields: [billingCycleDefaultId], references: [id])
  features            PlanVersionFeature[]
  subscriptions       Subscription[]

  @@unique([planId, versionNumber])
  @@index([statusId])
  @@map("plan_versions")
  @@schema("platform")
}

model PlanVersionFeature {
  id              String   @id @default(uuid()) @db.Uuid
  planVersionId   String   @map("plan_version_id") @db.Uuid
  featureId       String   @map("feature_id") @db.Uuid
  limitValue      String?  @map("limit_value")
  valueTypeId     String?  @map("value_type_id") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  planVersion PlanVersion       @relation(fields: [planVersionId], references: [id], onDelete: Cascade)
  feature     Feature           @relation(fields: [featureId], references: [id], onDelete: Cascade)
  valueType   FeatureValueType? @relation(fields: [valueTypeId], references: [id])

  @@unique([planVersionId, featureId])
  @@map("plan_version_features")
  @@schema("platform")
}

model Subscription {
  id                String    @id @default(uuid()) @db.Uuid
  organizationId    String    @map("organization_id") @db.Uuid
  productId         String    @map("product_id") @db.Uuid
  planId            String    @map("plan_id") @db.Uuid
  planVersionId     String    @map("plan_version_id") @db.Uuid
  statusId          String    @map("status_id") @db.Uuid
  billingCycleId    String    @map("billing_cycle_id") @db.Uuid
  planCode          String    @map("plan_code")
  planVersionNumber Int       @map("plan_version_number")
  priceAmount       Decimal   @map("price_amount") @db.Decimal(12, 2)
  currency          String
  snapshotJson      Json      @map("snapshot_json") @db.JsonB
  startsAt          DateTime  @map("starts_at") @db.Timestamptz(6)
  endsAt            DateTime? @map("ends_at") @db.Timestamptz(6)
  trialEndsAt       DateTime? @map("trial_ends_at") @db.Timestamptz(6)
  cancelledAt       DateTime? @map("cancelled_at") @db.Timestamptz(6)
  externalRef       String?   @map("external_ref")
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization                  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  product      Product                       @relation(fields: [productId], references: [id], onDelete: Restrict)
  plan         Plan                          @relation(fields: [planId], references: [id], onDelete: Restrict)
  planVersion  PlanVersion                   @relation(fields: [planVersionId], references: [id], onDelete: Restrict)
  status       SubscriptionStatus            @relation(fields: [statusId], references: [id])
  billingCycle BillingCycle                  @relation("SubscriptionBillingCycle", fields: [billingCycleId], references: [id])
  overrides    SubscriptionFeatureOverride[]

  @@index([organizationId, productId, statusId])
  @@index([statusId, endsAt])
  @@map("subscriptions")
  @@schema("platform")
}

model SubscriptionFeatureOverride {
  id               String    @id @default(uuid()) @db.Uuid
  subscriptionId   String    @map("subscription_id") @db.Uuid
  featureId        String    @map("feature_id") @db.Uuid
  overrideTypeId   String    @map("override_type_id") @db.Uuid
  limitValue       String?   @map("limit_value")
  reason           String
  approvedBy       String    @map("approved_by")
  statusId         String    @map("status_id") @db.Uuid
  startsAt         DateTime  @map("starts_at") @db.Timestamptz(6)
  endsAt           DateTime? @map("ends_at") @db.Timestamptz(6)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  subscription Subscription             @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  feature      Feature                  @relation(fields: [featureId], references: [id], onDelete: Cascade)
  overrideType SubscriptionOverrideType @relation(fields: [overrideTypeId], references: [id])
  status       AssignmentStatus         @relation(fields: [statusId], references: [id])

  @@index([subscriptionId, statusId])
  @@map("subscription_feature_overrides")
  @@schema("platform")
}

model OrganizationProductMembership {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  membershipId   String    @map("membership_id") @db.Uuid
  userProfileId  String    @map("user_profile_id") @db.Uuid
  productId      String    @map("product_id") @db.Uuid
  statusId       String    @map("status_id") @db.Uuid
  grantedAt      DateTime  @default(now()) @map("granted_at") @db.Timestamptz(6)
  revokedAt      DateTime? @map("revoked_at") @db.Timestamptz(6)

  organization Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  membership   OrganizationMembership  @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  userProfile  UserProfile             @relation(fields: [userProfileId], references: [id], onDelete: Cascade)
  product      Product                 @relation(fields: [productId], references: [id], onDelete: Cascade)
  status       ProductMembershipStatus @relation(fields: [statusId], references: [id])

  @@unique([organizationId, userProfileId, productId])
  @@index([statusId])
  @@map("organization_product_memberships")
  @@schema("platform")
}

model AuditLog {
  id              String    @id @default(uuid()) @db.Uuid
  organizationId  String?   @map("organization_id") @db.Uuid
  actorAuthUserId String?   @map("actor_auth_user_id") @db.Uuid
  actionTypeId    String    @map("action_type_id") @db.Uuid
  entityType      String    @map("entity_type")
  entityId        String    @map("entity_id")
  beforeJson      Json?     @map("before_json") @db.JsonB
  afterJson       Json?     @map("after_json") @db.JsonB
  ip              String?
  userAgent       String?   @map("user_agent")
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  archivedAt      DateTime? @map("archived_at") @db.Timestamptz(6)

  organization Organization?   @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  actionType   AuditActionType @relation(fields: [actionTypeId], references: [id])

  @@index([organizationId, createdAt])
  @@index([entityType, entityId])
  @@index([actorAuthUserId])
  @@index([actionTypeId])
  @@map("audit_logs")
  @@schema("platform")
}

model OutboxEvent {
  id             String    @id @default(uuid()) @db.Uuid
  aggregateType  String    @map("aggregate_type")
  aggregateId    String    @map("aggregate_id")
  eventType      String    @map("event_type")
  payloadJson    Json      @map("payload_json") @db.JsonB
  organizationId String?   @map("organization_id") @db.Uuid
  statusId       String    @map("status_id") @db.Uuid
  attempts       Int       @default(0)
  availableAt    DateTime  @default(now()) @map("available_at") @db.Timestamptz(6)
  processedAt    DateTime? @map("processed_at") @db.Timestamptz(6)
  lastError      String?   @map("last_error")
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  idempotencyKey String?   @unique @map("idempotency_key")
  archivedAt     DateTime? @map("archived_at") @db.Timestamptz(6)

  status OutboxEventStatus @relation(fields: [statusId], references: [id])

  @@index([statusId, availableAt])
  @@map("outbox_events")
  @@schema("platform")
}

model IdempotencyKey {
  id           String   @id @default(uuid()) @db.Uuid
  key          String
  scope        String
  requestHash  String   @map("request_hash")
  responseJson Json?    @map("response_json") @db.JsonB
  statusId     String   @map("status_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  expiresAt    DateTime @map("expires_at") @db.Timestamptz(6)

  status IdempotencyStatus @relation(fields: [statusId], references: [id])

  @@unique([scope, key])
  @@index([statusId])
  @@map("idempotency_keys")
  @@schema("platform")
}

model LegacyIdentityMapping {
  id                  String   @id @default(uuid()) @db.Uuid
  organizationId      String   @map("organization_id") @db.Uuid
  legacyAuthUserId    String   @map("legacy_auth_user_id")
  centralAuthUserId   String   @map("central_auth_user_id") @db.Uuid
  legacyEmployeeId    String   @map("legacy_employee_id")
  newEmployeeId       String?  @map("new_employee_id")
  migrationStatusId   String   @map("migration_status_id") @db.Uuid
  notes               String?
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization    Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  migrationStatus LegacyMigrationStatus @relation(fields: [migrationStatusId], references: [id])

  @@unique([organizationId, legacyAuthUserId])
  @@unique([organizationId, legacyEmployeeId])
  @@index([migrationStatusId])
  @@map("legacy_identity_mappings")
  @@schema("platform")
}
