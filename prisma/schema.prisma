// GoldenSoft Platform — PostgreSQL schema "platform"
// Architecture rule: master tables instead of Prisma/PostgreSQL enums.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
  schemas   = ["platform"]
}

// ─── Master / Lookup tables ───────────────────────────────────────────────

model UserProfileStatus {
  id          String   @id @default(uuid()) @db.Uuid
  code        String   @unique
  nameTh      String   @map("name_th")
  nameEn      String   @map("name_en")
  description String?
  sortOrder   Int      @default(0) @map("sort_order")
  isActive    Boolean  @default(true) @map("is_active")
  isSystem    Boolean  @default(true) @map("is_system")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  userProfiles UserProfile[]

  @@map("user_profile_statuses")
  @@schema("platform")
}

model PlatformRole {
  id          String   @id @default(uuid()) @db.Uuid
  code        String   @unique
  nameTh      String   @map("name_th")
  nameEn      String   @map("name_en")
  description String?
  sortOrder   Int      @default(0) @map("sort_order")
  isActive    Boolean  @default(true) @map("is_active")
  isSystem    Boolean  @default(true) @map("is_system")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  assignments PlatformRoleAssignment[]

  @@map("platform_roles")
  @@schema("platform")
}

model AssignmentStatus {
  id          String   @id @default(uuid()) @db.Uuid
  code        String   @unique
  nameTh      String   @map("name_th")
  nameEn      String   @map("name_en")
  description String?
