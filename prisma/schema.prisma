// GoldenSoft Platform — PostgreSQL schema "platform" only
// Do not define resident_v2 / hr / qrstation models in this repository.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
  schemas   = ["platform"]
}

enum UserProfileStatus {
  ACTIVE
  DISABLED
  PENDING

  @@schema("platform")
}

enum PlatformRole {
  SUPER_ADMIN
  SUPPORT
  BILLING_ADMIN

  @@schema("platform")
}

enum AssignmentStatus {
  ACTIVE
  REVOKED

  @@schema("platform")
}

enum OrganizationStatus {
  ACTIVE
  SUSPENDED
  CLOSED

  @@schema("platform")
}

enum BranchStatus {
  ACTIVE
  INACTIVE

  @@schema("platform")
}

enum MembershipStatus {
  INVITED
  ACTIVE
  SUSPENDED
  REMOVED

  @@schema("platform")
}

enum OrganizationRole {
  OWNER
  ADMIN
  BILLING_CONTACT

  @@schema("platform")
}

enum BranchScopeType {
  ALL_BRANCHES
  SELECTED
  NONE

  @@schema("platform")
}

enum CatalogStatus {
  ACTIVE
  RETIRED

  @@schema("platform")
}

enum PlanVersionStatus {
  DRAFT
  PUBLISHED
  RETIRED

  @@schema("platform")
}

enum BillingCycle {
  MONTHLY
  YEARLY
  MANUAL

  @@schema("platform")
}

enum SubscriptionStatus {
  TRIAL
  ACTIVE
  PAST_DUE
  SUSPENDED
  CANCELLED
  EXPIRED

  @@schema("platform")
}

enum OverrideEffect {
  GRANT
  REVOKE
  LIMIT

  @@schema("platform")
}

enum ProductMembershipStatus {
  ACTIVE
  SUSPENDED
  REVOKED

  @@schema("platform")
}

enum OutboxStatus {
  PENDING
  PROCESSING
  PROCESSED
  FAILED
  DEAD

  @@schema("platform")
}

enum IdempotencyStatus {
  IN_PROGRESS
  COMPLETED
  FAILED

  @@schema("platform")
}

enum MigrationStatus {
  PENDING
  LINKED
  MIGRATED
  FAILED
  IGNORED

  @@schema("platform")
}

model UserProfile {
  id             String            @id @default(uuid()) @db.Uuid
  /// Soft logical link to auth.users.id (same Supabase project). No FK into auth schema in this migration.
  authUserId     String            @unique @map("auth_user_id") @db.Uuid
  email          String            @unique
  displayName    String            @map("display_name")
  status         UserProfileStatus @default(PENDING)
  sessionVersion Int               @default(0) @map("session_version")
  lastLoginAt    DateTime?         @map("last_login_at") @db.Timestamptz(6)
  createdAt      DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt      DateTime?         @map("deleted_at") @db.Timestamptz(6)

  platformRoles              PlatformRoleAssignment[]
  memberships                OrganizationMembership[]
  preference                 UserPreference?
  organizationProductMembers OrganizationProductMembership[]

  @@index([status])
  @@map("user_profiles")
  @@schema("platform")
}

model UserPreference {
  id                 String   @id @default(uuid()) @db.Uuid
  userProfileId      String   @unique @map("user_profile_id") @db.Uuid
  lastOrganizationId String?  @map("last_organization_id") @db.Uuid
  lastBranchId       String?  @map("last_branch_id") @db.Uuid
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  userProfile UserProfile @relation(fields: [userProfileId], references: [id], onDelete: Cascade)

  @@map("user_preferences")
  @@schema("platform")
}

model PlatformRoleAssignment {
  id                   String           @id @default(uuid()) @db.Uuid
  userProfileId        String           @map("user_profile_id") @db.Uuid
  role                 PlatformRole
  status               AssignmentStatus @default(ACTIVE)
  assignedAt           DateTime         @default(now()) @map("assigned_at") @db.Timestamptz(6)
  assignedByAuthUserId String?          @map("assigned_by_auth_user_id") @db.Uuid
  revokedAt            DateTime?        @map("revoked_at") @db.Timestamptz(6)

  userProfile UserProfile @relation(fields: [userProfileId], references: [id], onDelete: Cascade)

  @@index([userProfileId, status])
  @@map("platform_role_assignments")
  @@schema("platform")
}

model Organization {
  id           String             @id @default(uuid()) @db.Uuid
  customerCode String             @unique @map("customer_code")
  slug         String             @unique
  legalName    String             @map("legal_name")
  displayName  String             @map("display_name")
  status       OrganizationStatus @default(ACTIVE)
  taxId        String?            @map("tax_id")
  timezone     String             @default("Asia/Bangkok")
  currency     String             @default("THB")
  createdAt    DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt    DateTime?          @map("deleted_at") @db.Timestamptz(6)

  branches               Branch[]
  memberships            OrganizationMembership[]
  subscriptions          Subscription[]
  productMemberships     OrganizationProductMembership[]
  auditLogs              AuditLog[]
  legacyIdentityMappings LegacyIdentityMapping[]

  @@map("organizations")
  @@schema("platform")
}

model Branch {
  id                     String       @id @default(uuid()) @db.Uuid
  organizationId         String       @map("organization_id") @db.Uuid
  code                   String
  name                   String
  status                 BranchStatus @default(ACTIVE)
  timezone               String       @default("Asia/Bangkok")
  address                String?
  latitude               Decimal?     @db.Decimal(10, 7)
  longitude              Decimal?     @db.Decimal(10, 7)
  attendanceRadiusMeters Int?         @map("attendance_radius_meters")
  createdAt              DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt              DateTime?    @map("deleted_at") @db.Timestamptz(6)

  organization Organization                         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branchScopes OrganizationMembershipBranchScope[]

  @@unique([organizationId, code])
  @@index([organizationId, status])
  @@map("branches")
  @@schema("platform")
}

model OrganizationMembership {
  id                  String           @id @default(uuid()) @db.Uuid
  organizationId      String           @map("organization_id") @db.Uuid
  userProfileId       String           @map("user_profile_id") @db.Uuid
  status              MembershipStatus @default(INVITED)
  joinedAt            DateTime?        @map("joined_at") @db.Timestamptz(6)
  invitedByAuthUserId String?          @map("invited_by_auth_user_id") @db.Uuid
  endedAt             DateTime?        @map("ended_at") @db.Timestamptz(6)
  createdAt           DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization       Organization                        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userProfile        UserProfile                         @relation(fields: [userProfileId], references: [id], onDelete: Cascade)
  roles              OrganizationMembershipRole[]
  branchScopes       OrganizationMembershipBranchScope[]
  productMemberships OrganizationProductMembership[]

  @@unique([organizationId, userProfileId])
  @@index([userProfileId, status])
  @@map("organization_memberships")
  @@schema("platform")
}

model OrganizationMembershipRole {
  id           String           @id @default(uuid()) @db.Uuid
  membershipId String           @map("membership_id") @db.Uuid
  role         OrganizationRole
  status       AssignmentStatus @default(ACTIVE)
  assignedAt   DateTime         @default(now()) @map("assigned_at") @db.Timestamptz(6)
  revokedAt    DateTime?        @map("revoked_at") @db.Timestamptz(6)

  membership OrganizationMembership @relation(fields: [membershipId], references: [id], onDelete: Cascade)

  @@index([membershipId, status])
  @@map("organization_membership_roles")
  @@schema("platform")
}

model OrganizationMembershipBranchScope {
  id           String           @id @default(uuid()) @db.Uuid
  membershipId String           @map("membership_id") @db.Uuid
  scopeType    BranchScopeType  @map("scope_type")
  branchId     String?          @map("branch_id") @db.Uuid
  status       AssignmentStatus @default(ACTIVE)
  createdAt    DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)

  membership OrganizationMembership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  branch     Branch?                @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@index([membershipId, status])
  @@map("organization_membership_branch_scopes")
  @@schema("platform")
}

model Product {
  id        String        @id @default(uuid()) @db.Uuid
  code      String        @unique
  name      String
  status    CatalogStatus @default(ACTIVE)
  createdAt DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  features           Feature[]
  plans              Plan[]
  subscriptions      Subscription[]
  productMemberships OrganizationProductMembership[]

  @@map("products")
  @@schema("platform")
}

model Feature {
  id          String        @id @default(uuid()) @db.Uuid
  productId   String        @map("product_id") @db.Uuid
  code        String        @unique
  name        String
  description String?
  status      CatalogStatus @default(ACTIVE)
  createdAt   DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  product               Product                       @relation(fields: [productId], references: [id], onDelete: Cascade)
  planVersionFeatures   PlanVersionFeature[]
  subscriptionOverrides SubscriptionFeatureOverride[]

  @@index([productId])
  @@map("features")
  @@schema("platform")
}

model Plan {
  id        String        @id @default(uuid()) @db.Uuid
  productId String        @map("product_id") @db.Uuid
  code      String
  name      String
  status    CatalogStatus @default(ACTIVE)
  createdAt DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  product       Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  versions      PlanVersion[]
  subscriptions Subscription[]

  @@unique([productId, code])
  @@map("plans")
  @@schema("platform")
}

model PlanVersion {
  id                  String            @id @default(uuid()) @db.Uuid
  planId              String            @map("plan_id") @db.Uuid
  versionNumber       Int               @map("version_number")
  status              PlanVersionStatus @default(DRAFT)
  billingCycleDefault BillingCycle      @default(MONTHLY) @map("billing_cycle_default")
  priceAmount         Decimal           @map("price_amount") @db.Decimal(12, 2)
  currency            String            @default("THB")
  trialDays           Int?              @map("trial_days")
  publishedAt         DateTime?         @map("published_at") @db.Timestamptz(6)
  createdAt           DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)

  plan          Plan                 @relation(fields: [planId], references: [id], onDelete: Cascade)
  features      PlanVersionFeature[]
  subscriptions Subscription[]

  @@unique([planId, versionNumber])
  @@map("plan_versions")
  @@schema("platform")
}

model PlanVersionFeature {
  id            String   @id @default(uuid()) @db.Uuid
  planVersionId String   @map("plan_version_id") @db.Uuid
  featureId     String   @map("feature_id") @db.Uuid
  limitValue    String?  @map("limit_value")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  planVersion PlanVersion @relation(fields: [planVersionId], references: [id], onDelete: Cascade)
  feature     Feature     @relation(fields: [featureId], references: [id], onDelete: Cascade)

  @@unique([planVersionId, featureId])
  @@map("plan_version_features")
  @@schema("platform")
}

model Subscription {
  id                String             @id @default(uuid()) @db.Uuid
  organizationId    String             @map("organization_id") @db.Uuid
  productId         String             @map("product_id") @db.Uuid
  planId            String             @map("plan_id") @db.Uuid
  planVersionId     String             @map("plan_version_id") @db.Uuid
  status            SubscriptionStatus @default(TRIAL)
  billingCycle      BillingCycle       @map("billing_cycle")
  planCode          String             @map("plan_code")
  planVersionNumber Int                @map("plan_version_number")
  priceAmount       Decimal            @map("price_amount") @db.Decimal(12, 2)
  currency          String
  /// Immutable entitlement snapshot (D102). JSONB. Never mutate after activation.
  snapshotJson      Json               @map("snapshot_json") @db.JsonB
  startsAt          DateTime           @map("starts_at") @db.Timestamptz(6)
  endsAt            DateTime?          @map("ends_at") @db.Timestamptz(6)
  trialEndsAt       DateTime?          @map("trial_ends_at") @db.Timestamptz(6)
  cancelledAt       DateTime?          @map("cancelled_at") @db.Timestamptz(6)
  externalRef       String?            @map("external_ref")
  createdAt         DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization                  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  product      Product                       @relation(fields: [productId], references: [id], onDelete: Restrict)
  plan         Plan                          @relation(fields: [planId], references: [id], onDelete: Restrict)
  planVersion  PlanVersion                   @relation(fields: [planVersionId], references: [id], onDelete: Restrict)
  overrides    SubscriptionFeatureOverride[]
  // Reserved (ADR-002 D103): subscription_items for base plan + add-ons — implement post-MVP.

  @@index([organizationId, productId, status])
  @@index([status, endsAt])
  @@map("subscriptions")
  @@schema("platform")
}

model SubscriptionFeatureOverride {
  id             String           @id @default(uuid()) @db.Uuid
  subscriptionId String           @map("subscription_id") @db.Uuid
  featureId      String           @map("feature_id") @db.Uuid
  effect         OverrideEffect
  limitValue     String?          @map("limit_value")
  reason         String
  approvedBy     String           @map("approved_by")
  status         AssignmentStatus @default(ACTIVE)
  startsAt       DateTime         @map("starts_at") @db.Timestamptz(6)
  endsAt         DateTime?        @map("ends_at") @db.Timestamptz(6)
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)

  subscription Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  feature      Feature      @relation(fields: [featureId], references: [id], onDelete: Cascade)

  @@index([subscriptionId, status])
  @@map("subscription_feature_overrides")
  @@schema("platform")
}

model OrganizationProductMembership {
  id             String                  @id @default(uuid()) @db.Uuid
  organizationId String                  @map("organization_id") @db.Uuid
  membershipId   String                  @map("membership_id") @db.Uuid
  userProfileId  String                  @map("user_profile_id") @db.Uuid
  productId      String                  @map("product_id") @db.Uuid
  status         ProductMembershipStatus @default(ACTIVE)
  grantedAt      DateTime                @default(now()) @map("granted_at") @db.Timestamptz(6)
  revokedAt      DateTime?               @map("revoked_at") @db.Timestamptz(6)

  organization Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  membership   OrganizationMembership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  userProfile  UserProfile            @relation(fields: [userProfileId], references: [id], onDelete: Cascade)
  product      Product                @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userProfileId, productId])
  @@map("organization_product_memberships")
  @@schema("platform")
}

model AuditLog {
  id              String    @id @default(uuid()) @db.Uuid
  organizationId  String?   @map("organization_id") @db.Uuid
  actorAuthUserId String?   @map("actor_auth_user_id") @db.Uuid
  action          String
  entityType      String    @map("entity_type")
  entityId        String    @map("entity_id")
  beforeJson      Json?     @map("before_json") @db.JsonB
  afterJson       Json?     @map("after_json") @db.JsonB
  ip              String?
  userAgent       String?   @map("user_agent")
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  archivedAt      DateTime? @map("archived_at") @db.Timestamptz(6)

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
  @@index([entityType, entityId])
  @@index([actorAuthUserId])
  @@map("audit_logs")
  @@schema("platform")
}

model OutboxEvent {
  id             String       @id @default(uuid()) @db.Uuid
  aggregateType  String       @map("aggregate_type")
  aggregateId    String       @map("aggregate_id")
  eventType      String       @map("event_type")
  payloadJson    Json         @map("payload_json") @db.JsonB
  organizationId String?      @map("organization_id") @db.Uuid
  status         OutboxStatus @default(PENDING)
  attempts       Int          @default(0)
  availableAt    DateTime     @default(now()) @map("available_at") @db.Timestamptz(6)
  processedAt    DateTime?    @map("processed_at") @db.Timestamptz(6)
  lastError      String?
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  idempotencyKey String?      @unique @map("idempotency_key")
  archivedAt     DateTime?    @map("archived_at") @db.Timestamptz(6)

  @@index([status, availableAt])
  @@map("outbox_events")
  @@schema("platform")
}

model IdempotencyKey {
  id           String            @id @default(uuid()) @db.Uuid
  key          String
  scope        String
  requestHash  String            @map("request_hash")
  responseJson Json?             @map("response_json") @db.JsonB
  status       IdempotencyStatus @default(IN_PROGRESS)
  createdAt    DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  expiresAt    DateTime          @map("expires_at") @db.Timestamptz(6)

  @@unique([scope, key])
  @@map("idempotency_keys")
  @@schema("platform")
}

model LegacyIdentityMapping {
  id                String          @id @default(uuid()) @db.Uuid
  organizationId    String          @map("organization_id") @db.Uuid
  legacyAuthUserId  String          @map("legacy_auth_user_id")
  centralAuthUserId String          @map("central_auth_user_id") @db.Uuid
  legacyEmployeeId  String          @map("legacy_employee_id")
  newEmployeeId     String?         @map("new_employee_id")
  migrationStatus   MigrationStatus @default(PENDING) @map("migration_status")
  notes             String?
  createdAt         DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, legacyAuthUserId])
  @@unique([organizationId, legacyEmployeeId])
  @@map("legacy_identity_mappings")
  @@schema("platform")
}
