  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  platformRoleAssignments              PlatformRoleAssignment[]
  organizationMembershipRoles          OrganizationMembershipRole[]
  organizationMembershipBranchScopes   OrganizationMembershipBranchScope[]
  subscriptionFeatureOverrides         SubscriptionFeatureOverride[]

  @@map("assignment_statuses")
  @@schema("platform")
}

