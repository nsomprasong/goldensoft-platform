APP_CODE=PLATFORM
NODE_ENV=development

EXPECTED_SUPABASE_PROJECT_REF=horyhrnqbeaivdztekfv
BLOCKED_LEGACY_SUPABASE_PROJECT_REF=invnwpyshxdadhocueeh

NEXT_PUBLIC_SUPABASE_URL=https://horyhrnqbeaivdztekfv.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

SUPABASE_SECRET_KEY=

# Public CA for Supabase Postgres TLS (runtime + preflight). Do not use a private key file.
SUPABASE_DB_CA_CERT_PATH=certs/prod-ca-2021.crt

# Copy from Supabase Connect Panel — do not invent hosts
# Transaction pooler (port 6543). Append pgbouncer=true when required.
# Do NOT add sslmode / sslrootcert / sslcert / sslkey — runtime supplies trusted SSL via pg.
DATABASE_URL=

# Session pooler (port 5432) for Prisma CLI / migrations.
# Must include: sslmode=verify-full&sslrootcert=../certs/prod-ca-2021.crt
DIRECT_URL=

PLATFORM_CONTEXT_COOKIE_SECRET=

# Must remain false in production
ALLOW_TEST_AUTH=false

