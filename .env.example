APP_CODE=PLATFORM
NODE_ENV=development

EXPECTED_SUPABASE_PROJECT_REF=horyhrnqbeaivdztekfv
BLOCKED_LEGACY_SUPABASE_PROJECT_REF=invnwpyshxdadhocueeh

NEXT_PUBLIC_SUPABASE_URL=https://horyhrnqbeaivdztekfv.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

SUPABASE_SECRET_KEY=

NEXT_PUBLIC_APP_URL=http://localhost:3000
SUPABASE_INVITE_REDIRECT_PATH=/auth/accept-invite
# Keep mock until PM approves the first real invite send.
AUTH_INVITE_MODE=mock
# First-real-invite safety gate (server only — never accept from client)
# AUTH_REAL_INVITE_TEST_EMAIL=
# AUTH_REAL_INVITE_CONFIRM=SEND_ONE_REAL_INVITE

# Public CA for Supabase Postgres TLS (runtime + preflight). Do not use a private key file.
SUPABASE_DB_CA_CERT_PATH=certs/prod-ca-2021.crt

# Copy from Supabase Connect Panel — do not invent hosts
# Transaction pooler (port 6543). Append pgbouncer=true when required.
# Do NOT add sslmode / sslrootcert / sslcert / sslkey — runtime supplies trusted SSL via pg.
DATABASE_URL=

# Session pooler (port 5432) for Prisma CLI / migrations.
# Must include: sslmode=verify-full&sslrootcert=../certs/prod-ca-2021.crt
DIRECT_URL=

PLATFORM_CONTEXT_COOKIE_SECRET=

# Must remain false in production
ALLOW_TEST_AUTH=false

# Customer App (org OWNER/ADMIN login destination — not Platform Admin)
# CUSTOMER_APP_URL=http://127.0.0.1:3002
CUSTOMER_APP_ORIGINS=http://127.0.0.1:3002,http://localhost:3002
# Production only — share Supabase + gs_platform_ctx across platform.* and app.*
# AUTH_COOKIE_DOMAIN=.goldensoft.cloud

# Phase 4B — first super admin bootstrap (do not commit real values)
# BOOTSTRAP_AUTH_USER_ID=
# BOOTSTRAP_ADMIN_EMAIL=
# BOOTSTRAP_ADMIN_DISPLAY_NAME=
# BOOTSTRAP_ORGANIZATION_CODE=
# BOOTSTRAP_BRANCH_CODE=

