# GoldenSoft Platform — copy to .env.local for local development
# Never commit .env, .env.local, or .env.production

APP_CODE=PLATFORM

# Supabase (new Central Auth project only — never Legacy)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key  # server only, never in browser

# Environment Guard
EXPECTED_SUPABASE_PROJECT_REF=YOUR_PROJECT_REF
BLOCKED_LEGACY_SUPABASE_PROJECT_REF=legacy-project-ref-here

# Database (local/test only — do not point at Legacy or Production in this phase)
DATABASE_URL=file:./dev.db

# Signed cookie for active org/branch context
PLATFORM_CONTEXT_COOKIE_SECRET=replace-with-long-random-secret

# Test-only auth bypass (never enable in production)
ALLOW_TEST_AUTH=0
